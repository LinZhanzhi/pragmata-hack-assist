# Python / training artifacts
__pycache__/
*.pyc
.venv/
venv/

# Keep folder structure even when empty
!**/.gitkeep

# Label Studio: keep the SQLite DB (the annotations live here) but never
# commit per-machine secrets or runtime journals.
panel_detector/labelstudio/.lsdata/.env
panel_detector/labelstudio/.lsdata/**/*.sqlite3-journal
panel_detector/labelstudio/.lsdata/**/*.sqlite3-wal
panel_detector/labelstudio/.lsdata/**/*.sqlite3-shm
panel_detector/labelstudio/.lsdata/**/*.sqlite3.bak_*
panel_detector/labelstudio/.lsdata/export/
panel_detector/labelstudio/.lsdata/media/upload/

# Cell extraction artifacts (regenerated by extract_cells.py)
panel_detector/cells/
panel_detector/cells_cls/
panel_detector/cells_lowconf_montage.png
panel_detector/cells_predictions*.json

# Auto-labeler outputs (transient; reviewed in LS then discarded)
cells_predictions*.json
panel_detector/cls_disagreements.json
panel_detector/runs/cell_classifier/
panel_detector/runs/current_check/
panel_detector/runs/path_demo/
panel_detector/runs/live/
yolov8n-cls.pt

# LS exports kept at repo root for reference, ignored from git
project-*-at-*.json
